822fd1="" data-v-3b9ae98b="" class="segment-code-inline">__init_subclass__</code>. Actually for ClassVar, the mutable default is shared across subclasses which is actually what we want for inheritance patterns. But it's safer to just use <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">= {}</code>.</div><div class="paragraph" dir="auto">Actually, a better pattern is:</div><div data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code"><div data-v-13fde6a9="" data-v-8d822fd1="" class="sticky-release" style="--sticky-header-height: 42.5px;"><div data-v-13fde6a9="" class="sticky-release-rail"><div data-v-13fde6a9="" class="sticky-release-header" style="top: 0px;"><header data-v-8d822fd1="" class="segment-code-header"><div data-v-8d822fd1="" class="segment-code-header-content"><span data-v-8d822fd1="" class="segment-code-lang">Python</span> <!----> <span data-v-868ea423="" data-v-8d822fd1=""><div data-v-1005b780="" data-v-868ea423="" class="icon-button" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Copy"><path d="M725.333333 302.933333a166.4 166.4 0 0 1 166.4 166.4v256a166.4 166.4 0 0 1-166.4 166.4h-256A166.4 166.4 0 0 1 302.933333 725.333333v-256A166.4 166.4 0 0 1 469.333333 302.933333h256z m-256 76.8A89.6 89.6 0 0 0 379.733333 469.333333v256c0 49.493333 40.106667 89.6 89.6 89.6h256a89.6 89.6 0 0 0 89.6-89.6v-256A89.6 89.6 0 0 0 725.333333 379.733333h-256z" fill="currentColor"></path><path d="M554.666667 132.266667a166.4 166.4 0 0 1 144.128 83.2 38.4 38.4 0 0 1-66.517334 38.4A89.514667 89.514667 0 0 0 554.666667 209.066667H298.666667A89.6 89.6 0 0 0 209.066667 298.666667v256c0 33.109333 17.92 62.08 44.8 77.653333a38.4 38.4 0 0 1-38.4 66.474667A166.4 166.4 0 0 1 132.266667 554.666667V298.666667A166.4 166.4 0 0 1 298.666667 132.266667h256z" fill="currentColor"></path></svg> <div data-v-5f9e9bf6="" data-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Copy</div></div></span></div></header></div></div></div> <div data-v-efb858b9="" data-v-8d822fd1="" class="syntax-highlighter dark segment-code-content"><pre data-v-efb858b9="" class="language-python"><code class="language-python">parameters_schema<span class="token punctuation">:</span> ClassVar<span class="token punctuation">[</span><span class="token builtin">dict</span><span class="token punctuation">[</span><span class="token builtin">str</span><span class="token punctuation">,</span> Any<span class="token punctuation">]</span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token punctuation">{</span><span class="token punctuation">}</span></code></pre></div></div> <div class="paragraph" dir="auto">This is fine because it's a class variable and subclasses override it.</div><div class="paragraph" dir="auto">Let me also think about whether <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">RobotState</code> and <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">Trajectory</code> should be in this file or imported. Since this is the base class, they should probably be defined here or in a separate types module. Defining them here is fine for now.</div><div class="paragraph" dir="auto">Also, should I include a <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">preconditions</code> / <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">postconditions</code> concept? That would be useful for the <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline">validate</code> script. Let me add that.</div><div class="paragraph" dir="auto">Actually, let me keep it clean but robust. The key things:</div><ol start="1"><li><div class="paragraph" dir="auto">ABC with abstract <code data-v-8d822fd1="" data-v-3b9ae98b="" class="segment-code-inline