    <span class="token comment"># ── Class-level metadata ───────────────────────────────────────────────</span>
    name<span class="token punctuation">:</span> ClassVar<span class="token punctuation">[</span><span class="token builtin">str</span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token string">""</span>
