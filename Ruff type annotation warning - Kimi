        <span class="token keyword">for</span> key<span class="token punctuation">,</span> spec <span class="token keyword">in</span> self<span class="token punctuation">.</span>parameters_schema<span class="token punctuation">.</span>items<span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">:</span>
