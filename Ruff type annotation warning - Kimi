    description<span class="token punctuation">:</span> ClassVar<span class="token punctuation">[</span><span class="token builtin">str</span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token string">""</span>
    author<span class="token punctuation">:</span> ClassVar<span class="token punctuation">[</span><span class="token builtin">str</span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token string">""</span>

    <span class="token comment">#: JSON-Schema-like dict describing the kwargs accepted by this primitive.</span>
