-v-1005b780="" class="kimi-tooltip tooltip-bottom icon-button-tooltip bottom">Download</div></div></div> <div data-v-1005b780="" data-v-634c6cb9="" class="icon-button primary" style="width: 32px; height: 32px;"><svg data-v-1005b780="" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" class="iconify" width="20" height="20" viewBox="0 0 1024 1024" name="Close"><path d="M766.037333 203.648a38.4 38.4 0 0 1 54.357334 54.314667L566.314667 512l254.08 254.037333a38.4 38.4 0 0 1-54.357334 54.357334L512 566.314667l-254.037333 254.08a38.4 38.4 0 0 1-54.314667-54.357334L457.685333 512 203.648 257.962667a38.4 38.4 0 0 1 54.314667-54.314667L512 457.685333l254.037333-254.037333z" fill="currentColor"></path></svg> <!----></div></div></header> <div data-v-15f18a21="" class="file-view-content">  <div data-v-a911dd75="" data-v-15f18a21="" class="file-view-core"> <div data-v-c9eaf1fe="" class="file-content file-text-content">[build-system]
requires = ["hatchling&gt;=1.18.0"]
build-backend = "hatchling.build"

[project]
name = "skill-primitives"
version = "0.0.1"
description = "Natural language to robot motion. Decompose LeRobot datasets into composable skill primitives."
readme = "README.md"
license = { text = "Apache-2.0" }
requires-python = "&gt;=3.9"
authors = [
    { name = "Asif Kazi", email = "kazisaadasif29@gmail.com" },
]
keywords = [
    "robotics",
    "robot-learning",
    "imitation-learning",
    "lerobot",
    "skill-composition",
    "natural-language",
    "manipulation",
    "trajectory-segmentation",
    "composable-skills",
    "foundation-models",
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Science/Research",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: Apache Software License",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Topic :: Scientific/Engineering :: Artificial Intelligence",
    "Typing :: Typed",
]
dependencies = [
    "numpy&gt;=1.23.0",
    "pandas&gt;=2.0.0",
    "pyarrow&gt;=12.0.0",
    "pyyaml&gt;=6.0",
    "tqdm&gt;=4.65.0",
    "datasets&gt;=2.14.0",
    "huggingface-hub&gt;=0.16.0",
    "pillow&gt;=10.0.0",
    "typing-extensions&gt;=4.7.0",
    "jinja2&gt;=3.1.0",
    "rich&gt;=13.0.0",
]

[project.optional-dependencies]
lerobot = [
    "lerobot&gt;=0.1.0",
]
llm = [
    "openai&gt;=1.0.0",
    "groq&gt;=0.4.0",
]
local = [
    "ollama&gt;=0.1.0",
]
viz = [
    "matplotlib&gt;=3.7.0",
    "imageio&gt;=2.31.0",
    "imageio-ffmpeg&gt;=0.4.8",
]
dev = [
    "pytest&gt;=7.4.0",
    "pytest-cov&gt;=4.1.0",
    "black&gt;=23.7.0",
    "ruff&gt;=0.0.280",
    "mypy&gt;=1.5.0",
    "pre-commit&gt;=3.3.0",
    "types-PyYAML",
]
paper = [
    "jupyter&gt;=1.0.0",
    "matplotlib&gt;=3.7.0",
    "seaborn&gt;=0.12.0",
    "scikit-learn&gt;=1.3.0",
]
all = [
    "skill-primitives[lerobot,llm,local,viz,dev,paper]",
]

[project.scripts]
sp-segment = "skill_primitives.cli.segment:main"
sp-annotate = "skill_primitives.cli.annotate:main"
sp-compose = "skill_primitives.cli.compose:main"
sp-demo = "skill_primitives.cli.demo:main"

[project.urls]
Homepage = "https://github.com/ksaad20/skill-primitives"
Documentation = "https://github.com/ksaad20/skill-primitives#readme"
Repository = "https://github.com/ksaad20/skill-primitives.git"
Issues = "https://github.com/ksaad20/skill-primitives/issues"
Changelog = "https://github.com/ksaad20/skill-primitives/blob/main/CHANGELOG.md"

[tool.hatch.build.targets.wheel]
packages = ["skill_primitives"]

[tool.hatch.build.targets.sdist]
include = [
    "/skill_primitives",
    "/README.md",
    "/LICENSE",
    "/CHANGELOG.md",
    "/CITATION.cff",
]

# ── Black ────────────────────────────────────────────────────────────────────
[tool.black]
line-length = 100
target-version = ["py39"]
include = '\.pyi?$'
extend-exclude = '''
/(
    \.git
  | \.venv
  | \.env
  | venv
  | env
  | build
  | dist
  | __pycache__
  | \.mypy_cache
  | \.pytest_cache
  | \.ruff_cache
  | node_modules
  | zoo
)/
'''

# ── Ruff ─────────────────────────────────────────────────────────────────────
[tool.ruff]
line-length = 100
target-version = "py39"
exclude = [
    "zoo",
    "build",
    "dist",
    ".venv",
    "venv",
    "env",
    "__pycache__",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
]

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "F",   # Pyflakes
    "I",   # isort
    "N",   # pep8-naming
    "W",   # pycodestyle warnings
    "UP",  # pyupgrade
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "SIM", # flake8-simplify
]
ignore = ["SIM102", "E501"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["skill_primitives"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
line-ending = "auto"

# ── mypy ─────────────────────────────────────────────────────────────────────
[tool.mypy]
python_version = "3.9"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
disallow_untyped_decorators = false
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true
strict_equality = true
show_error_codes = true
ignore_missing_imports = true

# ── pytest ───────────────────────────────────────────────────────────────────
[tool.pytest.ini_options]
minversion = "7.0"
testpaths = ["tests"]
python_files = ["test_*.py", "*_test.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = "-ra -q --strict-markers --tb=short"
markers = [
    "slow: marks tests as slow (deselect with '-m \"not slow\"')",
    "gpu: marks tests that require a GPU",
    "integration: marks integration tests",
]

# ── Coverage ─────────────────────────────────────────────────────────────────
[tool.coverage.run]
source = ["skill_primitives"]
branch = true
omit = [
    "*/tests/*",
    "*/test_*",
    "skill_primitives/cli/*",
    "skill_primitives/io/lerobot_adapter.py",
]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise AssertionError",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "if TYPE_CHECKING:",
]
fail_under = 20
show_missing = true
skip_covered = false
