        <span class="token triple-quoted-string string">"""Higher confidence for larger, clearer Z displacement."""</span>
        <span class="token keyword">if</span> z_rise <span class="token operator">&gt;</span> <span class="token number">0.1</span><span class="token punctuation">:</span>
