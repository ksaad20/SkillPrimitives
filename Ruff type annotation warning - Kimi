        speed <span class="token operator">=</span> self<span class="token punctuation">.</span>_compute_speed<span class="token punctuation">(</span>state<span class="token punctuation">,</span> velocity<span class="token punctuation">,</span> n<span class="token punctuation">)</span>
        <span class="token keyword">if</span> speed <span class="token keyword">is</span> <span class="token boolean">None</span><span class="token punctuation">:</span>
            <span class="token keyword">return</span> segments

        open_mask <span class="token operator">=</span> gripper <span class="token operator">&gt;=</span> self<span class="token punctuation">.</span>OPEN_THRESHOLD

        i <span class="token operator">=</span> <span class="token number">0</span>
