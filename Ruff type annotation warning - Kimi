        <span class="token keyword">if</span> <span class="token keyword">not</span> self<span class="token punctuation">.</span>parameters_schema<span class="token punctuation">:</span>
            <span class="token keyword">return</span> raw

        allowed <span class="token operator">=</span> <span class="token builtin">set</span><span class="token punctuation">(</span>self<span class="token punctuation">.</span>parameters_schema<span class="token punctuation">.</span>keys<span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span>
        unexpected <span class="token operator">=</span> <span class="token builtin">set</span><span class="token punctuation">(</span>raw<span class="token punctuation">.</span>keys<span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span> <span class="token operator">-</span> allowed
        <span class="token keyword">if</span> unexpected<span class="token punctuation">:</span>
            logger<span class="token punctuation">.</span>warning<span class="token punctuation">(</span>
